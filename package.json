{
  "name": "joystick-mapper",
  "productName": "Joystick Mapper",
  "version": "0.2.4",
  "private": true,
  "description": "Map a flight stick to a virtual Xbox 360 controller.",
  "author": "Halston",
  "license": "GPL-3.0-only",
  "repository": "github:Alphonsvds/joystick-mapper",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "fetch-driver": "node scripts/fetch-vigembus.mjs",
    "dist": "npm run fetch-driver && electron-builder --win --publish never"
  },
  "dependencies": {
    "koffi": "^3.3.2",
    "node-hid": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.joystickmapper.app",
    "productName": "Joystick Mapper",
    "copyright": "Copyright © 2026 Halston",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "build/vigembus",
        "to": "vigembus",
        "filter": [
          "*.exe",
          "*.txt"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Joystick Mapper",
      "artifactName": "Joystick-Mapper-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    }
  }
}
